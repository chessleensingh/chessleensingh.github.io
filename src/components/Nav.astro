---
import HeaderLink from './HeaderLink.astro';
---

<div class="nav-wrapper">
  <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
  <label for="nav-toggle" class="hamburger" aria-label="Toggle navigation">
    <span></span>
    <span></span>
    <span></span>
  </label>
  <nav class="nav-links" aria-label="Primary">
    <HeaderLink href="/research">Research</HeaderLink>
    <HeaderLink href="/publications">Publications</HeaderLink>
    <HeaderLink href="/cv">CV</HeaderLink>
    <HeaderLink href="/projects">Projects</HeaderLink>
    <HeaderLink href="/chess">Chess</HeaderLink>
    <HeaderLink href="/blog">Blog</HeaderLink>
    <HeaderLink href="/contact">Contact</HeaderLink>
  </nav>
</div>

<style>
  .nav-toggle { display: none; }
  .hamburger {
    display: none;
    flex-direction: column;
    cursor: pointer;
    gap: 4px;
    padding: 0.4em;
  }
  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
  }

  .nav-links {
    display: flex;
    gap: 1.4em;
    align-items: baseline;
  }
  .nav-links :global(a) {
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--ink);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1.5px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  .nav-links :global(a:hover) {
    color: var(--accent);
  }
  .nav-links :global(a.active) {
    color: var(--accent);
    border-bottom-color: var(--accent);
    font-weight: 600;
  }

  @media (max-width: 820px) {
    .nav-wrapper { position: relative; }
    .hamburger { display: flex; }

    .nav-links {
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      position: absolute;
      top: calc(100% + 0.6em);
      right: 0;
      background: var(--paper);
      border: 1px solid var(--rule);
      box-shadow: 0 6px 16px rgba(13, 16, 36, 0.08);
      padding: 0.4em 0;
      min-width: 180px;
      z-index: 100;
    }
    .nav-links :global(a) {
      padding: 0.6em 1.2em;
      border-bottom: 0;
    }
    .nav-links :global(a.active) {
      border-bottom: 0;
      background: var(--paper-deep);
    }
    .nav-toggle:checked ~ .nav-links { display: flex; }
  }
</style>

---
import { SITE_TITLE } from '../consts';
import Nav from './Nav.astro';
---

<header>
  <div class="header-inner">
    <h2><a href="/">{SITE_TITLE}</a></h2>
    <Nav />
  </div>
</header>

<style>
  header {
    margin: 0;
    padding: 0 1em;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 720px;
    margin: 0 auto;
    padding: 0;
  }

  h2 {
    margin: 0;
    font-size: 1em;
  }

  h2 a,
  h2 a.active {
    text-decoration: none;
    color: rgb(var(--black));
    padding: 1em 0;
    display: inline-block;
  }
</style>

---
import Nav from './Nav.astro';
---

<header class="masthead">
  <div class="masthead-inner">
    <a href="/" class="masthead-mark" aria-label="Home">
      <span class="mark-glyph">SS</span>
      <span class="mark-meta">Vol. 01 · Personal site</span>
    </a>
    <Nav />
  </div>
  <hr class="masthead-rule" />
</header>

<style>
  .masthead {
    background: var(--paper);
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: saturate(1.2);
  }
  .masthead-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    max-width: 760px;
    margin: 0 auto;
    padding: 1.5em 1em 0.9em;
    gap: 1em;
  }
  .masthead-mark {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 2px;
    line-height: 1;
  }
  .mark-glyph {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.7rem;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: -0.02em;
  }
  .mark-meta {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-muted);
    font-feature-settings: 'tnum';
  }
  .masthead-rule {
    border: 0;
    border-top: 1px solid var(--accent);
    max-width: 760px;
    margin: 0 auto;
    width: calc(100% - 2em);
  }

  @media (max-width: 720px) {
    .masthead-inner { padding: 1em 1em 0.6em; align-items: center; }
    .mark-glyph { font-size: 1.4rem; }
    .mark-meta { display: none; }
  }
</style>

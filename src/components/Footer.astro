<style>
  .colophon {
    margin-top: 4em;
    background: var(--paper-deep);
    border-top: 1px solid var(--accent);
  }
  .colophon-inner {
    max-width: 760px;
    margin: 0 auto;
    padding: 2.2em 1em 1.4em;
  }
  .colophon-cols {
    display: grid;
    grid-template-columns: 1fr 1fr 1.5fr;
    gap: 2.4em;
    margin-bottom: 1.6em;
  }
  .colophon-cols section { margin: 0; }
  .colophon h4 {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.5em;
    font-weight: 600;
  }
  .colophon p {
    font-size: 0.85rem;
    margin: 0;
    color: var(--ink-body);
    line-height: 1.55;
  }
  .colophon a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
  }
  .colophon a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    align-items: baseline;
  }
  .profile-links span { color: var(--rule-strong); }

  .colophon-baseline {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.78rem;
    color: var(--ink-faint);
    padding-top: 1em;
    border-top: 1px solid var(--rule);
  }

  @media (max-width: 720px) {
    .colophon-cols { grid-template-columns: 1fr; gap: 1.4em; }
    .colophon-baseline { flex-direction: column; gap: 4px; }
  }
</style>

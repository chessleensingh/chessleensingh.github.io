      <section>
        <h4>Contact</h4>
        <p><a href="mailto:sachleen.singh2412@gmail.com">sachleen.singh2412@gmail.com</a></p>
      </section>
      <section>
        <h4>Profiles</h4>
        <p class="profile-links">
          <a href="https://github.com/chessleensingh" target="_blank" rel="noopener">GitHub</a>
          <span aria-hidden="true">·</span>
          <a href="https://www.linkedin.com/in/sachleen-singh-582a32146/" target="_blank" rel="noopener">LinkedIn</a>
          <span aria-hidden="true">·</span>
          <a href="https://orcid.org/0009-0008-9395-7026" target="_blank" rel="noopener">ORCID</a>
          <span aria-hidden="true">·</span>
          <a href="https://scholar.google.com/citations?view_op=list_works&hl=en&user=LaatNtQAAAAJ" target="_blank" rel="noopener">Scholar</a>

---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
}

const { title, description, pubDate, updatedDate } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article>
    <div class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <FormattedDate date={pubDate} />
        {updatedDate && (
          <span class="updated">
            &mdash; Updated <FormattedDate date={updatedDate} />
          </span>
        )}
      </div>
      <p class="description">{description}</p>
      <hr />
    </div>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  article {
    max-width: 720px;
    margin: 0 auto;
  }

  .post-header {
    margin-bottom: 2em;
  }

  h1 {
    margin-bottom: 0.25em;
  }

  .post-meta {
    color: rgb(var(--gray));
    font-size: 0.9em;
    margin-bottom: 0.75em;
  }

  .updated {
    color: rgb(var(--gray));
  }

  .description {
    color: rgb(var(--gray-dark));
    font-style: italic;
    margin-bottom: 1em;
  }

  hr {
    border: none;
    border-top: 1px solid rgb(var(--gray-light));
  }
</style>

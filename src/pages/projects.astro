---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<BaseLayout
  title="Projects — Sachleen Singh"
  description="Side projects and open-source work by Sachleen Singh."
>
  <h1>Projects</h1>

  {projects.length === 0 && <p>No projects listed yet.</p>}

  <ul class="project-list">
    {projects.map((project) => (
      <li class="project-card">
        <div class="project-header">
          <h2>{project.data.title}</h2>
          <span class={`status-badge status-${project.data.status}`}>
            {project.data.status}
          </span>
        </div>
        <p class="project-description">{project.data.description}</p>
        <div class="project-tags">
          {project.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
        <div class="project-links">
          {project.data.github && (
            <a href={project.data.github} target="_blank" rel="noopener">
              GitHub
            </a>
          )}
          {project.data.url && (
            <a href={project.data.url} target="_blank" rel="noopener">
              Visit
            </a>
          )}
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .project-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.5em;
  }

  .project-card {
    border: 1px solid rgb(var(--gray-light));
    border-radius: 8px;
    padding: 1.5em;
  }

  .project-header {
    display: flex;
    align-items: center;
    gap: 0.75em;
    margin-bottom: 0.75em;
  }

  .project-header h2 {
    font-size: 1.2em;
    margin: 0;
  }

  .project-description {
    color: rgb(var(--gray-dark));
    font-size: 0.95em;
    margin-bottom: 1em;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    margin-bottom: 1em;
  }

  .tag {
    display: inline-block;
    font-size: 0.75em;
    padding: 0.2em 0.6em;
    background: rgb(var(--gray-light));
    border-radius: 4px;
    color: rgb(var(--gray-dark));
  }

  .project-links {
    display: flex;
    gap: 0.75em;
  }

  .project-links a {
    font-size: 0.875em;
    font-weight: 700;
  }

  .status-badge {
    display: inline-block;
    font-size: 0.7em;
    padding: 0.2em 0.6em;
    border-radius: 1em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .status-active { background: #e8f4e8; color: #2a6030; }
  .status-archived { background: rgb(var(--gray-light)); color: rgb(var(--gray)); }
</style>

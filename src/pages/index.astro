---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION } from '../consts';
---

<BaseLayout title="Sachleen Singh" description={SITE_DESCRIPTION}>
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">Computational genomics · Plant–microbe interactions</p>
      <h1 class="hero-name">Sachleen Singh</h1>
      <p class="hero-role">
        PhD Candidate, Molecular Biosciences<br />
        <span>Arkansas State University</span>
      </p>
      <p class="hero-bio">
        <span class="dropcap">P</span>hD candidate in Molecular Biosciences at Arkansas State
        University with a Master's in Computer Science. My dissertation combines long-read
        sequencing, methylation analysis, and gene regulatory network inference to understand how
        soybean plants defend against disease. I am currently exploring industry roles where I can
        apply computational and statistical methods to genomic data at scale.
      </p>
    </div>
    <aside class="hero-photo">
      <div class="photo-frame">
        <img src="/photo.jpg" alt="Sachleen Singh" width="200" height="240" />
      </div>
      <p class="photo-caption">fig. 01 &nbsp; Sachleen Singh, 2025.</p>
    </aside>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: 3em;
    align-items: start;
    padding: 1.5em 0 2em;
  }

  .hero-name {
    font-size: 4rem;
    line-height: 0.95;
    letter-spacing: -0.025em;
    margin: 0 0 0.5em;
  }

  .hero-role {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.4;
    color: var(--ink);
    margin: 0 0 1.5em;
  }
  .hero-role span { color: var(--ink-muted); }

  .hero-bio {
    font-size: 1rem;
    line-height: 1.75;
    max-width: 52ch;
    margin: 0;
    color: var(--ink-body);
  }
  .dropcap {
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 0.85;
    float: left;
    padding: 0.18em 0.32em 0 0;
    color: var(--accent);
    font-weight: 500;
  }

  .hero-photo {
    align-self: start;
    padding-top: 1.8em;
  }
  .photo-frame {
    position: relative;
    width: 200px;
    height: 240px;
    background: #fff;
    padding: 8px 8px 32px;
    border: 1px solid var(--rule-strong);
    box-shadow: 3px 4px 0 var(--accent);
  }
  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(0.15) contrast(1.02);
    display: block;
    border-radius: 0;
  }
  .photo-caption {
    margin: 0.8em 0 0;
    font-size: 0.75rem;
    font-style: italic;
    color: var(--ink-muted);
    font-family: var(--font-display);
  }

  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2em;
    }
    .hero-photo {
      padding-top: 0;
      order: -1;
      justify-self: start;
    }
    .hero-name { font-size: 2.6rem; }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION } from '../consts';
---

<BaseLayout title="Sachleen Singh" description={SITE_DESCRIPTION}>
  <div class="hero">
    <div class="hero-text">
      <h1>Sachleen Singh</h1>
      <p class="role">PhD Candidate, Molecular Biosciences &middot; Arkansas State University</p>
      <p class="bio">
        PhD candidate in Molecular Biosciences at Arkansas State University with a Master's in
        Computer Science. My dissertation combines long-read sequencing, methylation analysis, and
        gene regulatory network inference to understand how soybean plants defend against disease.
        I am currently exploring industry roles where I can apply computational and statistical
        methods to genomic data at scale.
      </p>
      <nav class="section-links" aria-label="Site sections">
        <a href="/research">Research</a>
        <a href="/publications">Publications</a>
        <a href="/cv">CV</a>
        <a href="/projects">Projects</a>
        <a href="/chess">Chess</a>
        <a href="/blog">Blog</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
    <div class="hero-photo">
      <img src="/photo.jpg" alt="Sachleen Singh" width="200" height="200" />
    </div>
  </div>
</BaseLayout>

<style>
  .hero {
    display: flex;
    align-items: flex-start;
    gap: 3em;
  }

  .hero-text {
    flex: 1;
  }

  h1 {
    margin-bottom: 0.2em;
  }

  .role {
    color: rgb(var(--gray));
    font-size: 1em;
    margin-top: 0;
    margin-bottom: 1.25em;
  }

  .bio {
    margin-bottom: 1.5em;
    font-size: 0.95em;
  }

  .section-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
  }

  .section-links a {
    display: inline-block;
    padding: 0.35em 1em;
    border: 2px solid var(--accent);
    border-radius: 4px;
    color: var(--accent);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.875em;
    transition: background 0.15s, color 0.15s;
  }

  .section-links a:hover {
    background: var(--accent);
    color: white;
  }

  .hero-photo img {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  @media (max-width: 720px) {
    .hero {
      flex-direction: column-reverse;
      align-items: center;
      text-align: center;
    }

    .section-links {
      justify-content: center;
    }

    .hero-photo img {
      width: 150px;
      height: 150px;
    }
  }
</style>

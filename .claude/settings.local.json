{
  "permissions": {
    "allow": [
      "Bash(npm create *)",
      "Bash(timeout 30 npm run dev -- --host 0.0.0.0)",
      "Bash(npm run *)",
      "Bash(kill %1)",
      "Bash(wait)",
      "Bash(Test-Path \"V:\\\\website\\\\.git\")",
      "Bash(Get-ChildItem -Path \"V:/website\" -Force)",
      "Bash(Select-Object Mode, Name)",
      "Bash(Test-Path \"V:/website/dist\" -PathType Container)",
      "Bash(Test-Path \"V:/website/dist/index.html\" -PathType Leaf)",
      "Bash(node *)",
      "Bash(Get-ChildItem -Path \"V:/website/.github\" -Recurse)",
      "Bash(Select-Object FullName)",
      "PowerShell(git *)",
      "Bash(git remote *)",
      "Bash(git branch *)",
      "Bash(git push *)",
      "Bash(gh workflow *)",
      "PowerShell(Remove-Item *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  }
}
